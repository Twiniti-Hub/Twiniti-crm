NODE_ENV=development
DEPLOYMENT_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
# Development database branches. These are also the inputs to
# pnpm db:migrate:regional when DEPLOYMENT_ENV=development.
DATABASE_URL_Dev_US=postgresql://user:password@localhost:5432/twiniti_crm_dev_us
DATABASE_URL_Dev_EU=
DATABASE_URL_Dev_UK=
# Production URLs belong in the protected Render/CI environment only.
DATABASE_URL_Prod_US=
DATABASE_URL_Prod_EU=
DATABASE_URL_Prod_UK=
# Legacy single-cell aliases; do not use for new services.
DATABASE_URL=
DATABASE_URL_EU=
DATABASE_URL_UK=
REGION_CODE=us
REGIONAL_APP_URL=
HEXCLAVE_BASE_URL=https://api.hexclave.com
HEXCLAVE_PROJECT_ID=
HEXCLAVE_SECRET_SERVER_KEY=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_TRACKING_DOMAIN=inbound.twiniti.ai
RESEND_FROM_EMAIL=Twiniti Loop <marketing@example.com>
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=
# Server-to-server License_API configuration. Never expose these in Vite or browser code.
# Production URL: https://license-api-q2sg.onrender.com
LICENSE_API_URL=
LICENSE_API_API_KEY=
LICENSE_API_PRODUCT_CODE=twiniti-loop
LICENSE_API_PLAN_CODE=standard
LICENSE_API_GRACE_PERIOD_DAYS=7
LICENSE_API_REQUEST_TIMEOUT_MS=5000
LICENSE_API_CACHE_TTL_MS=15000
# Set true in production so a missing/unavailable License_API cannot grant access.
LICENSE_API_REQUIRED=false
SUPER_ADMIN_EMAILS=george.broadbent@twiniti.ai
AUTH_DISABLED=true
BOOTSTRAP_ORG_NAME=Twiniti
BOOTSTRAP_OWNER_SUBJECT=
VITE_API_URL=
VITE_HEXCLAVE_PROJECT_ID=
VITE_HEXCLAVE_PUBLISHABLE_CLIENT_KEY=
# Public GA4 Measurement ID, e.g. G-XXXXXXXXXX. Tracking waits for consent.
VITE_GOOGLE_ANALYTICS_ID=
