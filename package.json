{
  "name": "twiniti-crm",
  "private": true,
  "version": "0.10.17",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @twiniti/api --filter @twiniti/web --filter @twiniti/worker dev",
    "build": "pnpm -r build",
    "check": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install chromium",
    "test": "pnpm --filter @twiniti/db test && pnpm --filter @twiniti/email test && pnpm --filter @twiniti/license-api test && pnpm --filter @twiniti/api test && pnpm --filter @twiniti/web test",
    "policy:check": "node scripts/policy/check-release-policy.mjs",
    "policy:db-chain": "node scripts/policy/check-migration-chain.mjs",
    "policy:db-chain:strict": "node scripts/policy/check-migration-chain.mjs --strict",
    "db:generate": "pnpm --filter @twiniti/db db:generate",
    "db:migrate": "pnpm --filter @twiniti/db db:migrate",
    "db:migrate:regional": "node --env-file=.env scripts/migrate-regional.mjs",
    "db:verify:regional": "pnpm --filter @twiniti/db exec tsx scripts/verify-regional-schemas.ts"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "0.25.12"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}
