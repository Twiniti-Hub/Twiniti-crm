{
  "name": "twiniti-crm",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @twiniti/api --filter @twiniti/web --filter @twiniti/worker dev",
    "build": "pnpm -r build",
    "check": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter @twiniti/db test && pnpm --filter @twiniti/email test && pnpm --filter @twiniti/api test && pnpm --filter @twiniti/web test",
    "db:generate": "pnpm --filter @twiniti/db db:generate",
    "db:migrate": "pnpm --filter @twiniti/db db:migrate"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "0.25.12"
    }
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}
