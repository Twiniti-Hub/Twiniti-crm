{
  "name": "twiniti-crm",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "pnpm --parallel --filter @twiniti/api --filter @twiniti/web dev",
    "build": "pnpm -r build",
    "check": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @twiniti/db db:generate",
    "db:migrate": "pnpm --filter @twiniti/db db:migrate"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}
